# ============================================================================
# EVR Billings Score - Environment Configuration Template
# ============================================================================
#
# SECURITY NOTICE:
# This is a template file. DO NOT use these placeholder values in production!
#
# Before deploying:
# 1. Copy this file to .env
# 2. Generate secure secrets (see instructions below)
# 3. Configure database and services
# 4. NEVER commit .env files to version control
#
# Quick Start - Generate Secure Secrets:
#   openssl rand -base64 32
#
# ============================================================================

# ----------------------------------------------------------------------------
# Server Configuration
# ----------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
# Valid values: development | production | test

# ----------------------------------------------------------------------------
# Database Configuration
# ----------------------------------------------------------------------------
# Option 1: Use DATABASE_URL (recommended for cloud deployments)
# DATABASE_URL=postgresql://username:password@host:5432/database_name

# Option 2: Use individual connection parameters (for local development)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=evr_billings
DB_USER=postgres
DB_PASSWORD=change-this-password

# Database SSL Configuration
# SECURITY: Set to 'true' in production to validate SSL certificates
# Only set to 'false' for development with self-signed certificates
DB_SSL_REJECT_UNAUTHORIZED=true

# ----------------------------------------------------------------------------
# Redis Configuration
# ----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# ----------------------------------------------------------------------------
# JWT (JSON Web Token) Configuration
# ----------------------------------------------------------------------------
# SECURITY CRITICAL: JWT_SECRET must be a strong, random value
#
# REQUIREMENTS:
# - Minimum 32 characters
# - Cryptographically random
# - Different for each environment
# - Never committed to version control
#
# Generate a secure secret:
#   openssl rand -base64 32
#
# Example output: xK8vN2mP9qL4wR7tY6uH3jF1gD5sA8bC0eZ9nM4kV2x
#
JWT_SECRET=REPLACE_WITH_SECURE_RANDOM_VALUE_FROM_OPENSSL
JWT_EXPIRES_IN=24h

# ----------------------------------------------------------------------------
# Session Configuration
# ----------------------------------------------------------------------------
# SECURITY CRITICAL: SESSION_SECRET must be a strong, random value
#
# REQUIREMENTS:
# - Minimum 32 characters
# - Cryptographically random
# - Different from JWT_SECRET
# - Different for each environment
#
# Generate a secure secret:
#   openssl rand -base64 32
#
SESSION_SECRET=REPLACE_WITH_DIFFERENT_SECURE_RANDOM_VALUE

# ----------------------------------------------------------------------------
# CORS (Cross-Origin Resource Sharing) Configuration
# ----------------------------------------------------------------------------
# Comma-separated list of allowed origins
# SECURITY: In production, specify exact origins (not *)
#
# Development:
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
#
# Production example:
# CORS_ORIGIN=https://app.example.com,https://admin.example.com

# ----------------------------------------------------------------------------
# QR Code Configuration
# ----------------------------------------------------------------------------
QR_CODE_EXPIRY_MINUTES=30

# SECURITY CRITICAL: QR_HMAC_SECRET is used to sign QR codes
#
# REQUIREMENTS:
# - Minimum 32 characters
# - Cryptographically random
# - Different from JWT_SECRET and SESSION_SECRET
# - If compromised, attackers can forge QR codes
#
# Generate a secure secret:
#   openssl rand -base64 32
#
QR_HMAC_SECRET=REPLACE_WITH_THIRD_SECURE_RANDOM_VALUE

# ----------------------------------------------------------------------------
# WebSocket Configuration
# ----------------------------------------------------------------------------
WS_PING_INTERVAL=25000
WS_PING_TIMEOUT=60000

# ============================================================================
# SECURITY CHECKLIST FOR PRODUCTION DEPLOYMENT
# ============================================================================
#
# [ ] Generated secure random values for all secrets using openssl
# [ ] JWT_SECRET is at least 32 characters
# [ ] SESSION_SECRET is at least 32 characters and different from JWT_SECRET
# [ ] QR_HMAC_SECRET is at least 32 characters and different from other secrets
# [ ] DB_SSL_REJECT_UNAUTHORIZED is set to 'true'
# [ ] CORS_ORIGIN contains only trusted domains (no wildcards)
# [ ] NODE_ENV is set to 'production'
# [ ] Database credentials are secure and not default values
# [ ] .env file is listed in .gitignore
# [ ] All placeholder values (REPLACE_WITH_*) have been replaced
# [ ] Secrets are stored securely (e.g., environment variables, secrets manager)
#
# ============================================================================
