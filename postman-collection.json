{
  "info": {
    "name": "EVR Billings Score API",
    "description": "API collection for EVR Billings Score V1 testing",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "sessionId",
      "value": "",
      "type": "string"
    },
    {
      "key": "sessionCode",
      "value": "",
      "type": "string"
    },
    {
      "key": "participantId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Sessions",
      "item": [
        {
          "name": "Create Session",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('sessionId', response.id);",
                  "    pm.collectionVariables.set('sessionCode', response.code);",
                  "    console.log('Session ID:', response.id);",
                  "    console.log('Session Code:', response.code);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Session\",\n  \"facilitatorId\": \"facilitator-123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/sessions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sessions"]
            }
          },
          "response": []
        },
        {
          "name": "Get Session by Code",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/sessions/{{sessionCode}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sessions", "{{sessionCode}}"]
            }
          },
          "response": []
        },
        {
          "name": "Get Session by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/sessions/id/{{sessionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sessions", "id", "{{sessionId}}"]
            }
          },
          "response": []
        },
        {
          "name": "Update Session",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"lobby\",\n  \"config\": {\n    \"maxParticipants\": 100\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/sessions/{{sessionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sessions", "{{sessionId}}"]
            }
          },
          "response": []
        },
        {
          "name": "Start Session",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/sessions/{{sessionId}}/start",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sessions", "{{sessionId}}", "start"]
            }
          },
          "response": []
        },
        {
          "name": "End Session",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/sessions/{{sessionId}}/end",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sessions", "{{sessionId}}", "end"]
            }
          },
          "response": []
        },
        {
          "name": "Delete Session",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/sessions/{{sessionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sessions", "{{sessionId}}"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Participants",
      "item": [
        {
          "name": "Join Session (Submitter)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('participantId', response.id);",
                  "    console.log('Participant ID:', response.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"Alice\",\n  \"role\": \"submitter\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/sessions/{{sessionId}}/join",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sessions", "{{sessionId}}", "join"]
            }
          },
          "response": []
        },
        {
          "name": "Join Session (Voter)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"Bob\",\n  \"role\": \"voter\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/sessions/{{sessionId}}/join",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sessions", "{{sessionId}}", "join"]
            }
          },
          "response": []
        },
        {
          "name": "Join Session (Anonymous)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"voter\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/sessions/{{sessionId}}/join",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sessions", "{{sessionId}}", "join"]
            }
          },
          "response": []
        },
        {
          "name": "Get Participant",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/participants/{{participantId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "participants", "{{participantId}}"]
            }
          },
          "response": []
        },
        {
          "name": "List Session Participants",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/participants/session/{{sessionId}}?activeOnly=true",
              "host": ["{{baseUrl}}"],
              "path": ["api", "participants", "session", "{{sessionId}}"],
              "query": [
                {
                  "key": "activeOnly",
                  "value": "true"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Update Participant",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"Alice Smith\",\n  \"hasSubmitted\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/participants/{{participantId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "participants", "{{participantId}}"]
            }
          },
          "response": []
        },
        {
          "name": "Update Participant Score",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"newScore\": 0.6,\n  \"round\": 1,\n  \"reason\": \"Submitted a great suggestion\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/participants/{{participantId}}/score",
              "host": ["{{baseUrl}}"],
              "path": ["api", "participants", "{{participantId}}", "score"]
            }
          },
          "response": []
        },
        {
          "name": "Remove Participant",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/participants/{{participantId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "participants", "{{participantId}}"]
            }
          },
          "response": []
        }
      ]
    }
  ]
}
